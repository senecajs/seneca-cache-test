From 49514a233ab67c1f4be1d1c1f0a74ebf076ea182 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 7 Oct 2026 21:11:42 +0000
Subject: [PATCH] ci: add the build workflow

Continuous integration for pushes and pull requests on master and main:
npm install, npm run build --if-present and npm test on Node.js 24 (the
default target) and 22 on ubuntu-latest, with the npm cache keyed on
package-lock.json.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01LaHppcejXbSsAH4BZXNsjV
---
 .github/workflows/build.yml | 31 +++++++++++++++++++++++++++++++
 1 file changed, 31 insertions(+)
 create mode 100644 .github/workflows/build.yml

diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
new file mode 100644
index 0000000..a8bc3fd
--- /dev/null
+++ b/.github/workflows/build.yml
@@ -0,0 +1,31 @@
+# Continuous integration: install and test on the supported Node.js
+# versions (24 is the default target, 22 is supported).
+
+name: build
+
+on:
+  push:
+    branches: [master, main]
+  pull_request:
+    branches: [master, main]
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+
+    strategy:
+      matrix:
+        node-version: [24.x, 22.x]
+
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Use Node.js ${{ matrix.node-version }}
+        uses: actions/setup-node@v4
+        with:
+          node-version: ${{ matrix.node-version }}
+          cache: npm
+
+      - run: npm install
+      - run: npm run build --if-present
+      - run: npm test
-- 
